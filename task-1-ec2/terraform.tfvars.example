aws_region  = "ap-south-1"
environment = "assessment"
owner       = "Naresh"

# Replace AMI and key pair with valid values for your AWS account and region.
instances = {
  app-01 = {
    ami = "ami-REPLACE_ME"
    instance_type = "t3.micro"
    key_name = "REPLACE_KEY_PAIR_APP01"
    root_volume_type = "gp3"
    root_volume_size = 20
    prevent_destroy = true
  }
  app-02 = {
    ami = "ami-REPLACE_ME"
    instance_type = "t3.small"
    key_name = "REPLACE_KEY_PAIR_APP02"
    root_volume_type = "gp2"
    root_volume_size = 25
  }
  app-03 = {
    ami = "ami-REPLACE_ME"
    instance_type = "t3.medium"
    key_name = "REPLACE_KEY_PAIR_APP03"
    root_volume_type = "io1"
    root_volume_size = 30
    root_volume_iops = 100
  }
  app-04 = {
    ami = "ami-REPLACE_ME"
    instance_type = "t3.large"
    key_name = "REPLACE_KEY_PAIR_APP04"
    root_volume_type = "io2"
    root_volume_size = 40
    root_volume_iops = 100
  }
  app-05 = {
    ami = "ami-REPLACE_ME"
    instance_type = "t2.micro"
    key_name = "REPLACE_KEY_PAIR_APP05"
    root_volume_type = "standard"
    root_volume_size = 50
  }
}
